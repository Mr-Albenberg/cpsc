# --- Required ---
APP_SECRET=replace-with-a-long-random-string-at-least-32-chars
PUBLIC_BASE_URL=https://cards.cpsconline.com
# Comma-separated. These people can always sign up and are made admins automatically.
ADMIN_EMAILS=you@example.com
PORT=3000

# --- Apple Wallet (needs an Apple Developer account, $99/yr) ---
APPLE_PASS_TYPE_ID=pass.com.cpsconline.membership
APPLE_TEAM_ID=ABCDE12345
APPLE_WWDR_PATH=./certs/wwdr.pem
APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
# On Railway/Render, skip the *_PATH lines and paste each file base64-encoded instead:
#   APPLE_WWDR_B64=...  APPLE_SIGNER_CERT_B64=...  APPLE_SIGNER_KEY_B64=...

# --- Google Wallet (free, via Google Pay & Wallet Console) ---
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_SERVICE_ACCOUNT_PATH=./certs/google-service-account.json
# or GOOGLE_SERVICE_ACCOUNT_B64=<base64 of the JSON key>
GOOGLE_CLASS_SUFFIX=cpsc_membership

# --- Optional branding ---
# ORG_NAME=Central Pacific Ski Club
# ORG_SHORT=CPSC
# PASS_BG=#0b1d33
# PASS_FG=#ffffff
# PASS_LABEL=#7fd0ff
# DATA_DIR=./data
